[Unit]
Description=KythOS unattended VM acceptance guest
After=network-online.target
Wants=network-online.target
# No unit Condition on the QEMU fw_cfg acceptance flag: the guest binary
# self-gates on /sys/firmware/qemu_fw_cfg/by_name/opt/com.kyth/acceptance/raw
# and exits successfully when it is absent. A ConditionPathExists here
# previously pointed at by_name/kyth/acceptance/raw — a path that never
# exists — so systemd skipped this unit on every boot and the acceptance
# guest never ran at all.

[Service]
Type=oneshot
# The guest executable owns the fw_cfg enablement check. Keeping it out of an
# ExecCondition avoids a boot-order race where systemd evaluates the condition
# before QEMU exposes the acceptance flag and permanently skips this oneshot.
ExecStart=/usr/libexec/kyth-vm-acceptance-guest run
TimeoutStartSec=1800
MemoryMax=4G
CPUQuota=50%
Nice=10
IOSchedulingClass=idle
StandardOutput=journal+console
StandardError=journal+console
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ProtectHome=yes
ProtectKernelModules=yes
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
