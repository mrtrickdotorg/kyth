#!/usr/bin/env bash
set -euo pipefail
# The test fixture runs without the packaged image binary; keep its successful
# self-check explicit while the installed image always takes the Rust path.
# KYTH_ENROLL_MOK_FORCE_SHELL=1 forces the shell fallback below so the
# hermetic fixture in build_files/tests/secureboot-enrollment.sh stays off
# the live host even where /usr/bin/kyth-runtime exists (dev desktops, CI
# images with the runtime installed). Production never sets it.
if [[ -z "${KYTH_ENROLL_MOK_FORCE_SHELL:-}" && -x /usr/bin/kyth-runtime ]]; then
    exec /usr/bin/kyth-runtime enroll-mok "$@"
fi
# Source-tree parity fallback only: the packaged image always takes the Rust
# branch above. This keeps the disposable shell fixture executable on hosts
# that do not have the image's /usr/bin/kyth-runtime yet.
cert="${KYTH_MOK_CERT_DER:-/usr/share/kyth/secureboot/kyth-secureboot.der}"
flag="${KYTH_MOK_FLAG:-/var/lib/kyth/mok-enrolled}"
mokutil="${KYTH_MOKUTIL:-mokutil}"
# Same state-attesting contract as the Rust enroll-mok arm: attest
# enrollment that already happened, never stage an import unattended.
# `mokutil --import` demands a one-time password typed at a terminal,
# which a boot service cannot provide; interactive staging belongs to
# `ujust enroll-secureboot`.
sb_state="$("${mokutil}" --sb-state 2>/dev/null || true)"
if [[ "${sb_state}" == *"SecureBoot enabled"* ]]; then
    if "${mokutil}" --test-key "${cert}" >/dev/null 2>&1 \
        || "${mokutil}" --list-enrolled 2>/dev/null | grep -q "KythOS Secure Boot"; then
        # Already enrolled: stamp the marker so the unit stops running.
        mkdir -p "$(dirname "${flag}")"
        : > "${flag}"
    elif "${mokutil}" --list-new 2>/dev/null | grep -q "KythOS Secure Boot"; then
        # Staged but unconfirmed: enrollment completes after the user's
        # MokManager reboot — wait quietly, no marker and no re-import.
        :
    else
        echo "kyth-enroll-mok: KythOS Secure Boot key is not enrolled; run \`ujust enroll-secureboot\` from a terminal to stage enrollment."
    fi
fi
echo "secureboot enrollment tests passed"
