# KythOS offline ISO installer image.
# The live environment is a purpose-built installer session on the stock
# Fedora bootc base — not a desktop preview — and the signed KythOS image
# is embedded as an OCI layout at /usr/lib/kyth/payload, so installation
# needs no network. installer/build.sh (KYTH_OFFLINE_ISO=1) verifies the
# embedded manifest digest against the same pinned, cosign-verified
# digest the network-install ISO uses before pointing the installer
# daemon at the oci: transport; the installed system still tracks the
# registry image for updates.
#
# Build with:
#   sudo podman build --cap-add SYS_ADMIN --security-opt label=disable \
#     --build-arg BASE_IMAGE=ghcr.io/mrtrickdotorg/kyth@sha256:<digest> \
#     --build-arg SOURCE_TAG=testing \
#     -t kyth-offline:build -f installer/Containerfile.offline .

ARG BASE_IMAGE=ghcr.io/mrtrickdotorg/kyth:latest
ARG BOOTC_BASE_IMAGE=quay.io/fedora/fedora-bootc:45@sha256:0ae801a078c884ff2553fb755c8a0cb7892523ab6c72d38cd786c592df587917

# ── Rust installer UI builder ────────────────────────────────────────────────
# Identical to installer/Containerfile: keep Node/Rust/WebKit development
# dependencies out of the payload image.
FROM registry.fedoraproject.org/fedora:45@sha256:e1e716b2f6ca98e1ed41e62d32a7bcbf1637d5b931894299eab9c659a16fe8ed AS installer-web-builder
ARG INSTALLER_BUILD_HASH=unset
RUN dnf5 install -y --setopt=install_weak_deps=False --skip-unavailable \
        cargo rust nodejs npm gcc gcc-c++ pkgconf-pkg-config \
        webkit2gtk4.1-devel javascriptcoregtk4.1-devel libsoup3-devel gtk3-devel dbus-devel && \
    dnf5 clean all
COPY src/kyth-shared-rs /build/kyth-shared-rs
COPY build_files/exe-handler-apps.json /build_files/exe-handler-apps.json
COPY src/kyth-installer-web /build/kyth-installer-web
COPY third_party/gtk-glib-0.18.5 /third_party/gtk-glib-0.18.5
RUN : "cache-bust:installer-web=${INSTALLER_BUILD_HASH}"
WORKDIR /build/kyth-installer-web
RUN --mount=type=cache,id=kyth-installer-web-npm,target=/root/.npm \
    rm -f node_modules && npm ci && npm run build
WORKDIR /build/kyth-installer-web/src-tauri
RUN --mount=type=cache,id=kyth-installer-cargo-registry,target=/root/.cargo/registry \
    --mount=type=cache,id=kyth-installer-target,target=/build/kyth-installer-web/src-tauri/target \
    cargo build --release --locked && \
    cargo build --release --locked --bin kyth-installer-native && \
    cargo build --release --locked --bin kyth-installerd && \
    cargo build --release --locked --bin kyth-installer-exec && \
    cp target/release/kyth-installer-shell /build/kyth-installer-shell && \
    cp target/release/kyth-installer-native /build/kyth-installer-native && \
    cp target/release/kyth-installerd /build/kyth-installerd && \
    cp target/release/kyth-installer-exec /build/kyth-installer-exec

# ── Embedded payload: the pinned image as an OCI layout ──────────────────────
# Copied by digest, so the layout's manifest digest is the pinned digest;
# installer/build.sh asserts exactly that before accepting the layout.
FROM registry.fedoraproject.org/fedora:45@sha256:e1e716b2f6ca98e1ed41e62d32a7bcbf1637d5b931894299eab9c659a16fe8ed AS payload-fetcher
ARG BASE_IMAGE
ARG INSTALL_SOURCE_IMAGE=${BASE_IMAGE}
ARG SOURCE_TAG=latest
RUN dnf5 install -y skopeo && dnf5 clean all
RUN skopeo copy "docker://${INSTALL_SOURCE_IMAGE}" "oci:/payload:${SOURCE_TAG}"

# ── KythOS assets the minimal base does not carry ────────────────────────────
# build.sh's Plymouth gate requires the kyth theme and the branding
# watermark in the rootfs. Take them from the signed image itself so the
# installer environment ships KythOS's own assets. These copies are NOT
# best-effort: a missing theme or watermark fails this build. Only the
# desktop icon lookup is allowed to come up empty (cosmetic).
FROM ${BASE_IMAGE} AS kyth-assets
RUN mkdir -p /assets/usr/share/plymouth/themes /assets/usr/share/kyth && \
    cp -a /usr/share/plymouth/themes/kyth /assets/usr/share/plymouth/themes/kyth && \
    cp -a /usr/share/kyth/branding /assets/usr/share/kyth/branding && \
    mkdir -p /assets/usr/share/icons && \
    (find /usr/share/icons -name 'kyth*' -exec cp -a --parents {} /assets \; || true)

FROM ${BOOTC_BASE_IMAGE}
ARG BASE_IMAGE
ARG INSTALL_SOURCE_IMAGE=${BASE_IMAGE}
ARG INSTALLER_BUILD_HASH=unset
ARG SOURCE_TAG=latest

COPY --from=installer-web-builder /build/kyth-installer-shell /usr/bin/kyth-installer-shell
COPY --from=installer-web-builder /build/kyth-installer-native /usr/bin/kyth-installer-native
COPY --from=installer-web-builder /build/kyth-installerd /usr/bin/kyth-installerd
COPY --from=installer-web-builder /build/kyth-installer-exec /usr/bin/kyth-installer-exec
COPY --from=payload-fetcher /payload /usr/lib/kyth/payload
COPY --from=kyth-assets /assets/ /

# Minimal installer session: plasmalogin autologin (configured by
# build.sh) into a KWin/Plasma session whose only job is the installer
# autostart, plus the tools build.sh assumes the full KythOS image
# already carries (skopeo/jq/curl for its signature gate, sudo for the
# liveuser grant). build.sh installs its own live packages on top.
RUN dnf5 install -y \
        plasmalogin plasma-workspace kwin plasma-nm kscreen \
        skopeo jq curl sudo && \
    dnf5 clean all && \
    systemctl enable plasmalogin.service && \
    systemctl set-default graphical.target

ARG INSTALLER_BUILD_HASH=unset
# Same rule as installer/Containerfile: build.sh is the RUN's final
# command so its exit code can never be masked by a chained command.
RUN --mount=type=bind,source=installer/build.sh,target=/src/installer/build.sh \
    --mount=type=bind,source=installer/iso.yaml,target=/src/installer/iso.yaml \
    --mount=type=bind,source=build_files/scripts,target=/src/build_files/scripts \
    --mount=type=bind,source=build_files/kyth-launch-installer,target=/src/build_files/kyth-launch-installer \
    --mount=type=bind,source=build_files/kyth-installerd.service,target=/src/build_files/kyth-installerd.service \
    --mount=type=bind,source=build_files/kyth-vm-acceptance.service,target=/src/build_files/kyth-vm-acceptance.service \
    : "cache-bust:installer=${INSTALLER_BUILD_HASH}" && \
    env BASE_IMAGE="${BASE_IMAGE}" INSTALL_SOURCE_IMAGE="${INSTALL_SOURCE_IMAGE}" \
    SOURCE_TAG="${SOURCE_TAG}" KYTH_OFFLINE_ISO=1 \
    bash /src/installer/build.sh
